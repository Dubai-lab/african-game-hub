{
  "name": "african-game-hub",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc",
    "e2e": "playwright test",
    "db:bundle": "node scripts/bundleMigrations.ts",
    "on-dev": "node scripts/onDev.ts",
    "server-keys": "node scripts/makeServerKeys.ts",
    "backup:ledger": "node server/backup.mjs",
    "game-art": "node scripts/makeGameArt.ts",
    "server:build": "node server/build.mjs",
    "server:dev": "node server/build.mjs && node --enable-source-maps server/dist/server.cjs",
    "db:push": "node scripts/dbPush.ts",
    "db:check": "node scripts/dbCheck.ts",
    "db:types": "node scripts/dbTypes.ts",
    "capture:hero": "node scripts/captureHero.ts",
    "online:check": "node scripts/checkOnlinePlay.ts",
    "functions:deploy": "node scripts/deployFunctions.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "icons": "node scripts/makeIcons.ts",
    "pieces": "node scripts/makePieces.ts",
    "perf": "node scripts/perfCheck.ts",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "deploy:player": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -Site player",
    "deploy:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -Site admin",
    "deploy:server": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy-server.ps1",
    "aws:off": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/kill-switch.ps1",
    "aws:on": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/kill-switch.ps1 -On"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/ojuju": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "chess.js": "^1.4.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "private": "true"
}

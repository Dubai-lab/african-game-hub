# Copy to .env.local and fill in. .env.local is never committed.

# --- Frontend (exposed to the browser; only VITE_ variables are) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side only. NEVER prefix these with VITE_. ---
# Used by tests and local scripts. Edge Functions get this key from Supabase automatically.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP for auth emails. Entered in the Supabase dashboard
# (Authentication > Emails > SMTP settings); kept here for reference only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS="your-gmail-app-password"
SMTP_SENDER_NAME="African Game Hub"

# Supabase Management API token (runs migrations, deploys functions). Server-side only.
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Public site address (used for link previews) and the contact address shown in the footer.
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=support@example.com
# Who runs the hub. Shown in the footer and on the legal pages. Use the real, registered details;
# leave a line out rather than invent one.
VITE_BUSINESS_NAME="Your Company Ltd"
VITE_BUSINESS_ADDRESS="Street, City, Country"
VITE_BUSINESS_REGISTRATION="Company registration no. 000000"

# The game server (see server/). Leave unset where there is none: moves then go through the
# Edge Functions, as they do whenever the game server cannot be reached.
# VITE_GAME_SERVER_URL=wss://your-site.example/ws

# development = the test scripts may create test accounts and play test games here.
# Leave unset on a live project.
AGH_ENVIRONMENT=development
# Password given to the fixed e2e-* test accounts on a development project. Pick a long random one.
E2E_TEST_PASSWORD=choose-a-long-random-password
